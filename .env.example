# --- Frontend (Vite) ---
# Omit or set to "false" to use mock auth + local medicines only (no API).
VITE_USE_LIVE_API=true

# --- API (backend/server.js) ---
PORT=4000
HOST=127.0.0.1

# USE_MYSQL=true → mysql2 adapter + normalized schema from Updated-Final-DB (see npm run db:seed).
# USE_MYSQL=false → in-memory demo users (frankie / demo1234) and sample rows only.
USE_MYSQL=true

# --- MySQL (when USE_MYSQL=true) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=life-long-logistics-inventory-main
