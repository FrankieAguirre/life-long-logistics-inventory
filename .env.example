# --- Frontend (Vite) ---
# Omit or set to "false" to use mock auth + local medicines only (no API).
VITE_USE_LIVE_API=true

# --- API (backend/server.js) ---
PORT=4000
HOST=127.0.0.1

# Default false = no MySQL required. npm start works out of the box.
# USE_MYSQL=true → run MySQL, then npm run db:seed once (see README).
USE_MYSQL=false

# --- MySQL (when USE_MYSQL=true) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=life-long-logistics-inventory-main
